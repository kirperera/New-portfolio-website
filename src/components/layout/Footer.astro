---
import Container from '../ui/Container.astro';
import { siteConfig } from '../../content/site';

const currentYear = new Date().getFullYear();
---

<footer class="bg-primary-dark text-slate-300 py-12 border-t border-slate-800" role="contentinfo">
  <Container class="space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-8 border-b border-slate-800">
      <!-- Col 1: Identity & Value -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded bg-accent text-white flex items-center justify-center font-serif text-sm font-bold">
            {siteConfig.monogram}
          </span>
          <span class="text-white font-semibold text-lg tracking-tight">
            {siteConfig.name}
          </span>
        </div>
        <p class="text-sm text-slate-400 max-w-md leading-relaxed">
          {siteConfig.positioningLine}. Building robust, evidence-backed data systems and geospatial intelligence.
        </p>
        <p class="text-xs text-slate-500">
          Last updated: {siteConfig.cv.lastUpdated} · Designed for recruiter verification.
        </p>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="space-y-3">
        <p class="text-xs font-semibold text-slate-200 uppercase tracking-wider">
          Quick Links
        </p>
        <ul class="space-y-2 text-sm">
          {
            siteConfig.navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-400 hover:text-white transition-colors duration-150"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/resume"
              class="text-slate-400 hover:text-white transition-colors duration-150"
            >
              HTML Résumé
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Contact & Proof Channels (FR-CONT-01, FR-CONT-02) -->
      <div class="space-y-3">
        <p class="text-xs font-semibold text-slate-200 uppercase tracking-wider">
          Channels
        </p>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="text-slate-400 hover:text-white transition-colors duration-150 flex items-center gap-2"
            >
              <span>Email</span>
            </a>
          </li>
          <li>
            <a
              href={siteConfig.contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-white transition-colors duration-150 flex items-center gap-2"
            >
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a
              href={siteConfig.contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-white transition-colors duration-150 flex items-center gap-2"
            >
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a
              href={siteConfig.cv.pdfPath}
              download={siteConfig.cv.fileName}
              class="text-accent hover:text-teal-300 font-medium transition-colors duration-150"
            >
              Download CV (PDF) ↓
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright & Disclaimer -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        &copy; {currentYear} {siteConfig.name}. All research and project data open or synthesized.
      </p>
      <p>
        Built with Astro, TypeScript, and Tailwind CSS. Hosted statically with zero trackers.
      </p>
    </div>
  </Container>
</footer>
