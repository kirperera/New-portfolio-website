---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .slice(0, 3);
---

<section id="projects" class="py-16 md:py-24 bg-white border-b border-border" aria-labelledby="featured-projects-title">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 md:mb-12">
      <SectionHeading
        kicker="Proven Technical Work"
        title="Featured Flagship Projects"
        description="Three representative case studies across Data Analytics, Machine Learning, and Spatial GIS. Each backed by reproducible code, open data sources, and measured business outcomes."
        class="mb-0"
      />
      <div class="mt-4 md:mt-0">
        <Button href="/projects" variant="outline" size="sm">
          <span>View All Case Studies</span>
          <span class="ml-1">→</span>
        </Button>
      </div>
    </div>

    <!-- 3-Card Flagship Grid (FR-HOME-05) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        featuredProjects.map((project) => (
          <Card hoverEffect class="flex flex-col justify-between h-full bg-surface border-slate-200">
            <div class="space-y-4">
              <!-- Card Header: Badges & Read Time -->
              <div class="flex items-center justify-between gap-2">
                <div class="flex flex-wrap gap-1.5">
                  {project.data.domain.map((dom) => (
                    <Badge domain={dom} />
                  ))}
                </div>
                <span class="text-xs text-muted font-mono shrink-0">
                  {project.data.readMinutes} min read
                </span>
              </div>

              <!-- Title -->
              <h3 class="text-xl font-bold font-serif text-primary hover:text-accent transition-colors leading-snug">
                <a href={`/projects/${project.slug}`}>
                  {project.data.title}
                </a>
              </h3>

              <!-- One-line Measurable Outcome (FR-HOME-05, FR-CASE-01) -->
              <div class="p-3 bg-surface-alt rounded border-l-4 border-accent text-xs leading-relaxed text-ink-soft">
                <span class="font-bold text-primary block mb-0.5">Measurable Outcome:</span>
                {project.data.outcome}
              </div>

              <!-- Context & Role -->
              <p class="text-xs text-muted">
                <span class="font-semibold text-slate-700">Role:</span> {project.data.role}
              </p>

              <!-- Tools Used -->
              <div class="pt-2">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
                  Key Technologies
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {project.data.tools.map((tool) => (
                    <span class="text-xs px-2 py-0.5 bg-slate-100 text-slate-700 rounded border border-slate-200">
                      {tool}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Card Footer: Case Study Link -->
            <div class="pt-6 mt-6 border-t border-border flex items-center justify-between">
              <a
                href={`/projects/${project.slug}`}
                class="text-sm font-semibold text-accent hover:text-accent-hover inline-flex items-center gap-1 group"
              >
                <span>Read Case Study</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </a>
              {project.data.links.repo && (
                <a
                  href={project.data.links.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs text-muted hover:text-primary transition-colors inline-flex items-center gap-1"
                  aria-label={`View ${project.data.title} source code on GitHub`}
                >
                  <span>Codebase</span>
                  <span>↗</span>
                </a>
              )}
            </div>
          </Card>
        ))
      }
    </div>
  </Container>
</section>
