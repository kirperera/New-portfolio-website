---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import StatusPill from '../ui/StatusPill.astro';
import { siteConfig } from '../../content/site';
---

<section
  class="relative pt-12 pb-16 md:pt-20 md:pb-24 bg-gradient-to-b from-surface to-surface-alt border-b border-border"
  aria-labelledby="hero-heading"
>
  <Container class="space-y-6">
    <!-- Internship Availability Indicator (FR-HOME-02) -->
    <div class="flex items-center gap-3">
      <StatusPill text={`${siteConfig.availability.status}: ${siteConfig.availability.window}`} />
      <span class="hidden sm:inline-block text-xs text-muted font-medium">
        {siteConfig.availability.mode} · {siteConfig.availability.duration}
      </span>
    </div>

    <!-- Candidate Identification & Positioning (FR-HOME-01) -->
    <div class="space-y-3 max-w-4xl">
      <h1
        id="hero-heading"
        class="text-3xl sm:text-5xl md:text-6xl font-extrabold font-serif text-primary tracking-tight"
      >
        {siteConfig.name}
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl font-medium text-ink-soft leading-snug">
        {siteConfig.positioningLine}
      </p>
    </div>

    <!-- Value Statement (FR-HOME-01) -->
    <p class="text-base sm:text-lg text-muted max-w-3xl leading-relaxed">
      {siteConfig.valueProposition}
    </p>

    <!-- Primary Action CTAs (FR-HOME-03) -->
    <div class="pt-2 flex flex-wrap items-center gap-4">
      <Button href="#projects" variant="primary" size="lg" id="hero-view-projects">
        <span>View Featured Projects</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="w-4 h-4 ml-1"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z"
            clip-rule="evenodd"
          />
        </svg>
      </Button>

      <Button
        href={siteConfig.cv.pdfPath}
        variant="secondary"
        size="lg"
        download={siteConfig.cv.fileName}
        id="hero-download-cv"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="w-4 h-4 mr-1 shrink-0"
          aria-hidden="true"
        >
          <path d="M10.75 2.75a.75.75 0 00-1.5 0v8.614L6.295 8.235a.75.75 0 10-1.09 1.03l4.25 4.5a.75.75 0 001.09 0l4.25-4.5a.75.75 0 00-1.09-1.03l-2.955 3.129V2.75z" />
          <path d="M3.5 12.75a.75.75 0 00-1.5 0v2.5A2.75 2.75 0 004.75 18h10.5A2.75 2.75 0 0018 15.25v-2.5a.75.75 0 00-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5z" />
        </svg>
        <span>Download CV (PDF)</span>
      </Button>

      <a
        href="#snapshot"
        class="text-sm font-semibold text-accent hover:text-accent-hover py-2 px-3 focus-visible:outline-none"
      >
        Recruiter Snapshot ↓
      </a>
    </div>
  </Container>
</section>
