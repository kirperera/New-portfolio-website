---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import ContactForm from '../interactive/ContactForm';
import { siteConfig } from '../../content/site';
---

<section id="contact" class="py-16 md:py-24 bg-primary text-white" aria-labelledby="contact-heading">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column: Direct Inquiries & CV (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <p class="text-xs uppercase tracking-wider font-semibold text-teal-400 mb-2">
            Get in Touch
          </p>
          <h2 id="contact-heading" class="text-3xl sm:text-4xl font-bold font-serif text-white leading-tight">
            Ready to contribute from day one.
          </h2>
        </div>

        <p class="text-sm text-slate-300 leading-relaxed">
          I am actively screening for upcoming internship cycles across Data Analytics, Data Science, and GIS. I welcome discussions regarding team fit, technical challenges, or project code reviews.
        </p>

        <!-- Direct Contact Channels (FR-CONT-01, FR-CONT-02) -->
        <div class="space-y-3 pt-2">
          <a
            href={`mailto:${siteConfig.contact.email}`}
            class="flex items-center gap-3 p-3.5 rounded bg-primary-light border border-slate-700/80 hover:border-teal-400 text-sm text-slate-200 hover:text-white transition-all group"
          >
            <span class="w-8 h-8 rounded bg-teal-900/60 text-teal-400 flex items-center justify-center font-bold text-sm shrink-0">
              ✉
            </span>
            <div>
              <span class="text-xs text-slate-400 block font-medium">Direct Email</span>
              <span class="font-semibold text-white group-hover:text-teal-300">{siteConfig.contact.email}</span>
            </div>
          </a>

          <a
            href={siteConfig.contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3.5 rounded bg-primary-light border border-slate-700/80 hover:border-teal-400 text-sm text-slate-200 hover:text-white transition-all group"
          >
            <span class="w-8 h-8 rounded bg-teal-900/60 text-teal-400 flex items-center justify-center font-bold text-sm shrink-0">
              in
            </span>
            <div>
              <span class="text-xs text-slate-400 block font-medium">LinkedIn Profile</span>
              <span class="font-semibold text-white group-hover:text-teal-300">linkedin.com/in/imanperera ↗</span>
            </div>
          </a>

          <a
            href={siteConfig.contact.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3.5 rounded bg-primary-light border border-slate-700/80 hover:border-teal-400 text-sm text-slate-200 hover:text-white transition-all group"
          >
            <span class="w-8 h-8 rounded bg-teal-900/60 text-teal-400 flex items-center justify-center font-bold text-sm shrink-0">
              ⌥
            </span>
            <div>
              <span class="text-xs text-slate-400 block font-medium">GitHub Repository Profile</span>
              <span class="font-semibold text-white group-hover:text-teal-300">github.com/imanperera ↗</span>
            </div>
          </a>
        </div>

        <!-- Single-Click CV Button (FR-HOME-03, FR-CV-01) -->
        <div class="pt-4 border-t border-slate-800">
          <Button
            href={siteConfig.cv.pdfPath}
            variant="secondary"
            size="lg"
            download={siteConfig.cv.fileName}
            class="w-full justify-center"
            id="contact-download-cv"
          >
            Download ATS-Friendly CV (PDF) ↓
          </Button>
        </div>
      </div>

      <!-- Right Column: Interactive Web Contact Form (7 cols) -->
      <div class="lg:col-span-7 bg-primary-light p-6 sm:p-8 rounded-xl border border-slate-700 shadow-card">
        <h3 class="text-lg font-bold font-serif text-white mb-2">
          Send a Direct Message
        </h3>
        <p class="text-xs text-slate-300 mb-6">
          Fill out the form below or reach out directly via email or LinkedIn.
        </p>
        <ContactForm client:visible />
      </div>
    </div>
  </Container>
</section>
