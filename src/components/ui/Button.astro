---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  download?: boolean | string;
  target?: string;
  rel?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  download,
  target,
  rel,
  id,
  type = 'button',
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none text-center';

const variantStyles = {
  primary: 'bg-primary text-white hover:bg-primary-dark active:scale-[0.98] shadow-sm',
  secondary: 'bg-accent text-white hover:bg-accent-hover active:scale-[0.98] shadow-sm',
  outline: 'border border-primary text-primary hover:bg-primary hover:text-white active:scale-[0.98]',
  ghost: 'text-primary hover:bg-surface-alt active:bg-slate-200',
};

const sizeStyles = {
  sm: 'text-xs px-3 py-1.5 gap-1.5 min-h-[36px]',
  md: 'text-sm px-4 py-2 gap-2 min-h-[44px]',
  lg: 'text-base px-6 py-3 gap-2.5 min-h-[48px]',
};

const classes = [baseStyles, variantStyles[variant], sizeStyles[size], className].join(' ');
---

{
  href ? (
    <a
      href={href}
      class={classes}
      download={download}
      target={target}
      rel={target === '_blank' ? (rel || 'noopener noreferrer') : rel}
      id={id}
      aria-label={ariaLabel}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={classes}
      id={id}
      aria-label={ariaLabel}
      {...rest}
    >
      <slot />
    </button>
  )
}
