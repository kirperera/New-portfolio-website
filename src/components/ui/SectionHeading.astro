---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  kicker,
  title,
  description,
  align = 'left',
  class: className = '',
} = Astro.props;

const alignmentClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class:list={['mb-8 md:mb-12 max-w-2xl', alignmentClass, className]}>
  {kicker && (
    <p class="text-xs uppercase tracking-wider font-semibold text-accent mb-2">
      {kicker}
    </p>
  )}
  <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold font-serif text-primary">
    {title}
  </h2>
  {description && (
    <p class="mt-3 text-base text-muted leading-relaxed">
      {description}
    </p>
  )}
</div>
