---
import { getCollection } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  
  // Sort projects chronologically
  const sorted = projects.sort((a, b) => a.data.updated.getTime() - b.data.updated.getTime());

  return sorted.map((project, index) => {
    const prevProject = index > 0 ? { slug: sorted[index - 1].slug, title: sorted[index - 1].data.title } : null;
    const nextProject = index < sorted.length - 1 ? { slug: sorted[index + 1].slug, title: sorted[index + 1].data.title } : null;

    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await project.render();
---

<CaseStudyLayout project={project} prevProject={prevProject} nextProject={nextProject}>
  <Content />
</CaseStudyLayout>
