---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page Not Found (404)" description="The requested portfolio page could not be found.">
  <div class="py-24 md:py-36 bg-surface-alt flex items-center justify-center">
    <Container class="max-w-md text-center space-y-6">
      <span class="text-xs uppercase font-bold tracking-wider text-accent">
        Error 404
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold font-serif text-primary">
        Page Not Found
      </h1>
      <p class="text-sm text-muted leading-relaxed">
        The page or case study you requested could not be located. It may have been moved, renamed, or is currently under revision.
      </p>
      <div class="pt-4 flex items-center justify-center gap-4">
        <Button href="/" variant="primary" size="md">
          Return to Home
        </Button>
        <Button href="/projects" variant="outline" size="md">
          View Projects
        </Button>
      </div>
    </Container>
  </div>
</BaseLayout>
